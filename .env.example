# =============================================
# MotoTaxi — Variables de Entorno
# Copiar a .env y completar los valores reales
# =============================================

# ── JWT ──────────────────────────────────────
JWT_SECRET=mototaxi-jwt-secret-key-2024-CAMBIAR-EN-PROD

# ── Auth Service DB (MySQL independiente) ────
AUTH_DB_HOST=mysql-auth
AUTH_DB_PORT=3306
AUTH_DB_USER=root
AUTH_DB_PASSWORD=mototaxi123
AUTH_DB_NAME=mototaxi_auth

# ── Rides Service DB (MySQL independiente) ───
RIDES_DB_HOST=mysql-rides
RIDES_DB_PORT=3306
RIDES_DB_USER=root
RIDES_DB_PASSWORD=mototaxi123
RIDES_DB_NAME=mototaxi_rides

# ── Ratings Service DB (MongoDB) ─────────────
MONGO_URI=mongodb://mongodb:27017/mototaxi_ratings

# ── Tracking Service (MySQL + Redis) ─────────
TRACKING_DB_HOST=mysql-rides
TRACKING_DB_PORT=3306
TRACKING_DB_USER=root
TRACKING_DB_PASSWORD=mototaxi123
TRACKING_DB_NAME=mototaxi_rides
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=  # Dejar vacío si no tiene password

# ── Payments Service DB (MySQL independiente) ─
PAYMENTS_DB_HOST=mysql-payments
PAYMENTS_DB_PORT=3306
PAYMENTS_DB_USER=root
PAYMENTS_DB_PASSWORD=mototaxi123
PAYMENTS_DB_NAME=mototaxi_payments

# ── Frontend ──────────────────────────────────
VITE_API_URL=https://mrt.viewdns.net/api
VITE_SOCKET_URL=https://mrt.viewdns.net

# ── AWS (GitHub Secrets — NO COLOCAR AQUÍ) ───
# Configurar como GitHub Secrets en tu repositorio:
# AWS_ACCESS_KEY_ID      → IAM user con permisos ECS/ECR
# AWS_SECRET_ACCESS_KEY  → Secret del IAM user
# AWS_ACCOUNT_ID         → ID de tu cuenta AWS (12 dígitos)
# S3_BUCKET_APP          → Nombre del bucket S3 del frontend
# CLOUDFRONT_DISTRIBUTION_ID → ID de tu distribución CloudFront

# ── Vercel (GitHub Secrets) ──────────────────
# VERCEL_TOKEN           → Token de API de Vercel
# VERCEL_ORG_ID          → ID de tu organización en Vercel
# VERCEL_PROJECT_ID_LANDING → ID del proyecto landing en Vercel

# ── Dominio ──────────────────────────────────
DOMAIN=mrt.viewdns.net
