    },
    {
      "name": "payments-service",
      "image": "<AWS_ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/mototaxi/payments-service:latest",
      "portMappings": [
        {
          "containerPort": 3005,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "PORT", "value": "3005" },
        { "name": "DB_HOST", "value": "<RDS_ENDPOINT>" },
        { "name": "DB_PORT", "value": "3306" },
        { "name": "DB_USER", "value": "admin" },
        { "name": "DB_PASSWORD", "value": "mototaxi123" },
        { "name": "DB_NAME", "value": "mototaxi" }
      ],
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mototaxi",
          "awslogs-region": "<REGION>",
